# Copy to .env and fill in. This file is the control panel's OWN config —
# separate from any managed project's .env on VM 100.

# Session cookie signing key — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Encrypts per-project secrets (managed projects' env vars) at rest in the
# panel's own DB — deliberately separate from SECRET_KEY, different threat
# model. Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes every stored project secret unrecoverable — back it up.
ENCRYPTION_KEY=

# Where the panel's SQLite DB and audit log live (relative to this directory)
DB_PATH=data/panel.db

# The one machine this tool manages today. Always an IP, never a hostname —
# VM 100's own hostname is literally "app-node" (same as the Proxmox host), so
# hostname-based identification is unsafe on this network.
VM100_IP=10.10.0.20
VM100_SSH_USER=deploy
ORCHESTRATOR_KEY_PATH=/home/deploy/.ssh/orchestrator_vm100

# Seeded only on first startup, if the users table is empty. Change the
# password after first login — this is a bootstrap value, not meant to
# persist.
ADMIN_BOOTSTRAP_USERNAME=deploy
ADMIN_BOOTSTRAP_EMAIL=operator@example.com
ADMIN_BOOTSTRAP_PASSWORD=
