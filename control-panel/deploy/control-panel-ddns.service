[Unit]
Description=Control Panel — DuckDNS dynamic-DNS updater (oneshot)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
WorkingDirectory=/home/deploy/control-panel
ExecStart=/home/deploy/control-panel/venv/bin/python3 -m app.ddns
StandardOutput=append:/home/deploy/control-panel/ddns.log
StandardError=append:/home/deploy/control-panel/ddns.log
