[Unit]
Description=Control Panel (homelab deploy tool)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
WorkingDirectory=/home/deploy/control-panel
ExecStart=/home/deploy/control-panel/venv/bin/uvicorn app.main:app --host 10.10.0.21 --port 8500
Restart=always
RestartSec=3
StandardOutput=append:/home/deploy/control-panel/control-panel.log
StandardError=append:/home/deploy/control-panel/control-panel.log

[Install]
WantedBy=multi-user.target
