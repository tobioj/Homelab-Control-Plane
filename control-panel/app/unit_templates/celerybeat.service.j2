[Unit]
Description=celery beat for {{ project_name }}
After=network.target

[Service]
User=deploy
Group=www-data
WorkingDirectory={{ app_dir }}
EnvironmentFile={{ app_dir }}/.env
ExecStart={{ app_dir }}/venv/bin/celery -A {{ celery_app or "config" }} beat --loglevel=info{% if framework == 'django' %} --scheduler django_celery_beat.schedulers:DatabaseScheduler{% endif %}
Restart=on-failure

[Install]
WantedBy=multi-user.target
